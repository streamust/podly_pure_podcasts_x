# ===================
# --- Basic Setup ---
# ===================

# NOTE: Environment variables set here always take precedence over settings
# configured through the web UI. Fields controlled by env vars will appear
# as read-only in the UI. Remove an env var to allow UI control again.

# Podly will work out of the box with just a valid Groq key
# You can do more advanced setup with alternative hosted models or
# self-hosted OpenAI-compatible services below.
GROQ_API_KEY=gsk_abcdefghjiklmnopqrstuvwxyz

# ======================
# --- Advanced Setup ---
# ======================

# ========================================
# --- LLM (OpenAI-compatible or proxy) ---
# ========================================

# Base URL is IGNORED when LLM_MODEL is provider-prefixed like the examples below:
# groq/openai/gpt-oss-120b  (Groq API)
# anthropic/claude-3.5-sonnet (Anthropic API)
# gemini/gemini-3-flash-preview (Google API)
# gemini/gemini-2.0-flash (Google API)

# Base URL is USED for:
# Unprefixed models like gpt-4o
# Self-hosted OpenAI-compatible endpoints
# LiteLLM proxy servers or local LLMs

LLM_API_KEY=sk-your-openai-or-compatible-key
LLM_MODEL=gpt-4o

# locally hosted endpoint
# OPENAI_BASE_URL=

# Advanced LLM tuning (all optional)
# OPENAI_TIMEOUT=300
# OPENAI_MAX_TOKENS=4096
# LLM_MAX_CONCURRENT_CALLS=3
# LLM_MAX_RETRY_ATTEMPTS=5
# LLM_ENABLE_TOKEN_RATE_LIMITING=false
# LLM_MAX_INPUT_TOKENS_PER_CALL=  # leave blank to disable
# LLM_MAX_INPUT_TOKENS_PER_MINUTE=  # leave blank to disable
# LLM service tier passed to providers that support it (OpenAI, Gemini).
# One of: default | flex | priority | auto. 'flex' is ~50% cheaper but
# slower and may 429/503; the call wrapper retries with exponential
# backoff and falls back to standard on exhaustion. Ignored for
# providers without service tiers (Anthropic, Groq, ...).
# LLM_SERVICE_TIER=default

# =========================
# --- Whisper selection ---
# =========================

# Choose: remote | groq
WHISPER_TYPE=groq

# Remote Whisper (any OpenAI-compatible transcription server).
# For a local / self-hosted backend we recommend one of:
#   WhisperX API server: https://github.com/Nyralei/whisperx-api-server
#   ParakeetX:           https://github.com/MaroonBrian1928/parakeetX
# Point WHISPER_REMOTE_BASE_URL at your server, e.g. http://localhost:8000/v1
WHISPER_REMOTE_API_KEY=
WHISPER_REMOTE_BASE_URL=https://api.openai.com/v1
WHISPER_REMOTE_MODEL=whisper-1
WHISPER_REMOTE_TIMEOUT_SEC=600
WHISPER_REMOTE_CHUNKSIZE_MB=24
# Optional OpenAI-compatible diarization flags
# Requires a backend that supports these extra transcription parameters.
# speaker embeddings only apply when diarization is enabled.
WHISPER_REMOTE_DIARIZE=false
WHISPER_REMOTE_SPEAKER_EMBEDDINGS=false

# Optional INA audio segmentation (better ad boundaries).
# A separate HTTP service (inaSpeechSegmenter) that tags non-speech regions such
# as music, jingles, and silence. The transcript can't "hear" these, so Podly
# uses them as LLM cues for ad breaks AND to clean up cut boundaries (bridging
# ad windows split by music/silence, and trimming leading/trailing stings).
# Off by default since it runs a separate service + an extra audio pass.
# Expected API: POST {INA_BASE_URL}/segment
# Ready-made local server: https://github.com/MaroonBrian1928/InaFastAPI
INA_ENABLED=false
INA_BASE_URL=http://localhost:8001
INA_TIMEOUT_SEC=3600

# Repeat-ad detection. Dynamically-inserted ads are often stitched into an
# episode multiple times verbatim, and the classifier occasionally flags only
# some copies. When enabled, Podly matches each detected ad against the rest of
# the transcript (deterministic text match), asks the LLM to confirm each
# candidate is advertisement content, and removes the confirmed repeats too.
# Off by default since it adds a small LLM call per matched repeat.
ENABLE_REPEAT_AD_DETECTION=false

# Groq Whisper
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MAX_RETRIES=0

# ===============
# --- General ---
# ===============

SERVER_THREADS=1

# Show extended troubleshooting details in the episode stats modal.
# Includes guid, download_url, audio paths, and resolved path candidates.
PODLY_STATS_DEBUG=false

# Log file rotation. The active log file is capped at PODLY_LOG_MAX_BYTES;
# PODLY_LOG_BACKUP_COUNT rotated copies are kept (app.log.1 .. app.log.N).
# Defaults give ~50 MB active + 5 backups ≈ 300 MB total on disk.
PODLY_LOG_MAX_BYTES=50000000
PODLY_LOG_BACKUP_COUNT=5

# =====================
# --- Rust sidecar ---
# =====================

# The Docker image builds podly_tools into this path. Leave this alone unless
# you are testing a locally built sidecar binary.
PODLY_RUST_TOOLS_BIN=/app/bin/podly_tools

# These paths are ENABLED BY DEFAULT. Leave them alone for normal use; the
# sidecar automatically falls back to Python on any error. Set a flag to false
# only to opt out of that path (e.g. when validating parity or isolating a bug).
PODLY_RUST_AUDIO_ENABLED=true
PODLY_RUST_CHAPTERS_ENABLED=true
PODLY_RUST_FEED_REFRESH_ENABLED=true
PODLY_RUST_FEED_XML_ENABLED=true
PODLY_RUST_JOBS_ENABLED=true
PODLY_RUST_STATS_ENABLED=true
PODLY_RUST_TRANSCRIPT_ENABLED=true
PODLY_RUST_AD_MERGE_ENABLED=true
PODLY_RUST_PROFANITY_ENABLED=true
PODLY_RUST_FEED_POSTS_ENABLED=true
PODLY_RUST_WORD_BOUNDARY_ENABLED=true
PODLY_RUST_CHAPTER_FALLBACK_ENABLED=true
PODLY_RUST_COSTS_ENABLED=true
PODLY_RUST_REPEAT_AD_ENABLED=true

# Sting anchor: deterministic sting-template boundary correction after
# refinement (see podcast_processor/sting_anchor.py). Enabled by default;
# set to false to disable. Anchoring only happens for feeds listed in
# the JSON config PODLY_STING_CONFIG points at (template + measured
# per-show offsets; see sting_config.example.json and
# scripts/capture_sting_template.py). Leave PODLY_STING_CONFIG empty to
# keep the feature inert.
PODLY_STING_ANCHOR_ENABLED=true
PODLY_STING_CONFIG=

# Timeout (seconds) for audio sidecar commands (cut/bleep/split). These
# re-encode the whole episode, and profanity bleeping runs one ffmpeg pass per
# 96 censor windows serially -- an episode with many windows can take several
# minutes. The default (3600s) is generous; lower only if you'd rather fall back
# to Python sooner. (Too low a value causes spurious "Rust fell back to Python"
# on long bleep jobs.)
# PODLY_RUST_AUDIO_TIMEOUT_SEC=3600

# Stripe revenue lookups in the admin cost dashboard. When off (default), the
# `subscription_amount_cents` field on each user is left null and the stripe
# SDK is never imported into the long-lived process. Turn on only if you
# track revenue and want the cost-vs-revenue view.
PODLY_STRIPE_BILLING_ENABLED=false

# =====================
# --- Memory tuning ---
# =====================

# Preload jemalloc in the Docker image to replace glibc's ptmalloc allocator.
# Workload-dependent: tends to help long-lived processes with native extensions
# and large transient buffers (XML parsing, audio, numpy). May be a wash on
# small-object-dominated workloads. Set to 0 to fall back to ptmalloc.
PODLY_JEMALLOC_PRELOAD=1

# jemalloc tuning baked into the image: background purging and two arenas.
# Override only to diagnose allocator behavior.
# MALLOC_CONF=background_thread:true,narenas:2

# Periodic gc.collect() + malloc_trim() in the web process, in minutes. Set to
# 0 to disable. Targets slow allocator-arena drift during long idle periods
# that the on-demand trims (after feed refresh, etc.) never catch.
PODLY_MEMORY_TRIM_INTERVAL_MIN=15

# Idle trim cadence for the writer service, in seconds. Only fires if the
# writer actually processed commands since the last trim, so a fully idle
# writer doesn't churn syscalls. Set to 0 to disable.
# Rust waits for no active handlers or queued/running commands, then requests
# an optional jemalloc arena purge on its existing SQLite owner thread. This
# does not release live SQLite/runtime allocations; missing jemalloc is logged.
# Like the Python writer, Rust also purges after each named action except
# dequeue_job, touch_feed_access_token, and update_user_last_active.
# The existing PODLY_MEMORY_TRIM_ENABLED master switch also disables Rust
# purging. Rust caps extreme positive intervals at one year for bounded waits.
PODLY_WRITER_IDLE_TRIM_INTERVAL_SEC=900

# Emit one redacted JSON timing record per writer command. Intended for
# isolated migration benchmarks; leave disabled in normal operation.
PODLY_WRITER_TIMING_LOG=false

# Selects exactly one runtime writer implementation: rust (default) or python.
PODLY_WRITER_BACKEND=rust

# Isolated writer acceptance benchmark controls (CI only, not service settings).
# Export these in the shell when using mise exec -- ./scripts/ci.sh --writer-benchmark
# or --writer-baseline (the latter freezes a replacement Python P0 report);
# CI does not load this dotenv file. Never point the fixture/output at live data.
# PODLY_WRITER_BENCH_IMAGE=podly-rust-writer-p4:your-isolated-image-tag
# PODLY_WRITER_BENCH_BASELINE=/tmp/your-matched-python-baseline/report.json
# PODLY_WRITER_BENCH_THRESHOLD_REPORT=/tmp/podly-rust-writer-baseline/report.json
# PODLY_WRITER_BENCH_REPETITIONS=5  # required when spread could reverse a gate
# PODLY_WRITER_BENCH_OUTPUT=/tmp/your-new-isolated-benchmark-directory
# Without an output override CI creates a unique /tmp directory.

# Shared local-process secret. Rust writer mode refuses to start if this is
# empty or missing. Replace this placeholder with a long random value.
PODLY_IPC_AUTHKEY=replace-with-a-random-local-secret

# Master switch for the on-demand release_memory_to_os() helper. Leave on
# unless you're trying to isolate whether trimming is causing a regression.
# The web also trims and closes idle pooled SQLite connections about one
# second after each request burst when this is enabled.
# PODLY_MEMORY_TRIM_ENABLED=true

# =====================
# --- Authentication ---
# =====================

# STRONGLY RECOMMENDED. Auth is enabled by default in this example so the web
# UI, feeds, and downloads require login. Without it, anyone who can reach your
# server's URL can read and control your feeds. Leave this on, especially for
# any public / internet-exposed deployment.
#
# !! Before exposing Podly, you MUST change the two values below !!
#   - PODLY_ADMIN_PASSWORD: replace with your own strong password.
#   - PODLY_SECRET_KEY:     replace with a long random string. Generate one with:
#                             python -c "import secrets; print(secrets.token_hex(32))"
#
# Podcast apps still work with auth on: use the Config page's "Copy protected
# feed" button, which embeds a per-feed access token in the URL so players can
# subscribe without your admin password. (See the note on PocketCasts and
# public feeds in docs/how_to_run_beginners.md.)
#
# To run fully open with NO login (not recommended), set REQUIRE_AUTH=false.
REQUIRE_AUTH=true
PODLY_ADMIN_USERNAME=podly_admin
PODLY_ADMIN_PASSWORD=ChangeMe123!
PODLY_SECRET_KEY=replace-with-a-strong-random-value

# Optional UI feature flags
# Hides Discord SSO/config integration surfaces such as the login button and Config tab.
# PODLY_HIDE_DISCORD_INTEGRATION=false
# Hides the "Report issue" button in the desktop nav and mobile menu.
# PODLY_HIDE_REPORT_ISSUE_BUTTON=false
